# Environment — never commit the API key
.env
.env.*
!.env.example

# Dependencies (this project has none at runtime, but keep it safe)
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.code-workspace

# Local Claude settings
.claude/settings.local.json
.claude/todos.local.json

# NOTE: public/videos.json is intentionally NOT ignored — it is generated by the
# build and committed by the scheduled Action so the static host needs no build step.
